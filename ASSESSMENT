        "import re\n",
        "\n",
        "def is_suspicious(url):\n",
        "    ip_pattern = '\\\\d+\\\\.\\\\d+\\\\.\\\\d+\\\\.\\\\d+'\n",
        "    suspicious_words = ('verify', 'update', 'secure', 'login')\n",
        "\n",
        "    if re.search(ip_pattern, url):\n",
        "        return False\n",
        "    for word in suspicious_words:\n",
        "        if word not in url:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "urls = ['http://192.168.1.10/verify-account', 'https://mybank.com/login']\n",
        "for u in urls:\n",
        "    print(u, '->', is_suspicious(u))\n"
