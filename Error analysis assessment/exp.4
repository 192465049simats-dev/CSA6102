      "source": [
        "custody_log = []\n",
        "\n",
        "def add_entry(evidence_id, handler, action):\n",
        "    entry = {'evidence_id': evidence_id, 'handler': handler, 'action': action}\n",
        "    custody_log.append(entry)\n",
        "\n",
        "def print_log():\n",
        "    for entry in custody_log:\n",
        "        print(str(entry['evidence_id']) +  \" - \"  + str(entry['handler']) +  \" - \"  + str(entry['action']))\n",
        "\n",
        "add_entry('EVD-101', 'A.Kumar', 'Collected')\n",
        "add_entry('EVD-101', 'S.Rao', 'Analysed')\n",
        "print_log()"
      ]
